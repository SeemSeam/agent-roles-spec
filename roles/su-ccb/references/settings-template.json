{
  "permissions": {
    "defaultMode": "default",
    "allowProjectHooks": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/preusetool-block-askuser.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/preusetool-block-archive-writes.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
