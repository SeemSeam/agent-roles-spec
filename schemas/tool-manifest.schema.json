{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Role Tool Manifest Preview",
  "type": "object",
  "required": ["schema", "name", "version", "description", "runtime", "tools"],
  "properties": {
    "schema": {
      "const": "agent-role/tool-manifest/preview-0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "required": ["scope", "install_policy"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["role-private", "project-private", "host-provided", "documentation-only"]
        },
        "install_policy": {
          "type": "string",
          "enum": ["explicit", "manual", "host-managed", "none"]
        },
        "store_hint": {
          "type": "string"
        },
        "secrets": {
          "type": "string",
          "enum": ["external", "none"]
        },
        "cleanup": {
          "type": "string",
          "enum": ["unmount-owned", "manual", "host-owned", "none"]
        },
        "network": {
          "type": "string"
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "optional", "description"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["mcp-server", "cli", "browser-runtime", "library", "adapter-plugin", "other"]
          },
          "optional": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "adapter_targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_secrets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_project": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "install": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["host-provided", "package-manager", "manual", "none"]
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "doctor": {
            "type": "object",
            "properties": {
              "checks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "projection": {
            "type": "object",
            "properties": {
              "template": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
